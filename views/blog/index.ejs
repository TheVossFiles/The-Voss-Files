<%- include('../partials/header') %>

<div class="page-header">
  <h1>Development Log</h1>
  <p>Engineering dispatches, milestone updates, and technical notes from the team.</p>
</div>

<section class="mt-4 mb-4">
  <div class="grid-2 stagger">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <article class="card blog-card">
          <div class="card-body">
            <div class="blog-meta">
              <span>By <%= post.author_name %></span>
              <span>•</span>
              <time><%= new Date(post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
            </div>
            <h2><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
            <p class="blog-excerpt mt-1"><%= post.body.replace(/\n/g, ' ').substring(0, 160) %>...</p>
          </div>
          <div class="mt-3">
            <a href="/blog/<%= post.slug %>" class="btn btn-secondary btn-sm">Read Article &rarr;</a>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="card text-center" style="grid-column: 1 / -1;">
        <p class="text-muted">No blog dispatches currently published.</p>
      </div>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <ul class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li>
          <a href="/blog?page=<%= i %>" class="<%= page === i ? 'active' : '' %>"><%= i %></a>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>

<%- include('../partials/footer') %>
