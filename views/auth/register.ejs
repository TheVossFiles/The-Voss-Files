<%- include('../partials/header') %>

<div class="card form-card fade-in">
  <h1>Register Auditor Clearance</h1>

  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach(err => { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="username">Username (Letters, numbers, underscores)</label>
      <input type="text" name="username" id="username" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" value="<%= (typeof formData !== 'undefined' && formData.username) ? formData.username : '' %>" required autofocus>
    </div>

    <div class="form-group">
      <label for="email">Institutional / Personal Email</label>
      <input type="email" name="email" id="email" class="form-control" type="email" inputmode="email" autocomplete="email" value="<%= (typeof formData !== 'undefined' && formData.email) ? formData.email : '' %>" required>
    </div>

    <div class="form-group">
      <label for="password">Password (Minimum 8 characters)</label>
      <input type="password" name="password" id="password" class="form-control" autocomplete="new-password" required>
    </div>

    <div class="form-group">
      <label for="password_confirm">Confirm Password</label>
      <input type="password" name="password_confirm" id="password_confirm" class="form-control" autocomplete="new-password" required>
    </div>

    <div class="mt-3">
      <button type="submit" class="btn btn-primary w-full">Create Clearance Account</button>
    </div>

    <div class="text-center mt-3 text-sm text-secondary">
      Already cleared? <a href="/login">Sign in to your account</a>.
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
