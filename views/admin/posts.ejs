<%- include('../partials/header') %>

<div class="admin-layout mt-4 mb-4">
  <%- include('sidebar', { activeTab: 'posts' }) %>

  <div class="admin-content">
    <div class="card mb-4 flex-between">
      <div>
        <h1>Dev Blog Articles</h1>
        <p class="text-secondary text-sm mt-1">Manage public articles, release notes, and developer logs.</p>
      </div>
      <a href="/admin/posts/new" class="btn btn-primary">+ Write New Article</a>
    </div>

    <div class="card">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Slug</th>
              <th>Author</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(p => { %>
              <tr>
                <td><strong><%= p.title %></strong></td>
                <td><code class="text-muted"><%= p.slug %></code></td>
                <td><%= p.author_name %></td>
                <td>
                  <span class="badge badge-<%= p.is_published ? 'resolved' : 'open' %>"><%= p.is_published ? 'PUBLISHED' : 'DRAFT' %></span>
                </td>
                <td class="text-muted text-sm"><%= new Date(p.created_at).toLocaleDateString() %></td>
                <td>
                  <div class="admin-table-actions">
                    <a href="/blog/<%= p.slug %>" class="btn btn-secondary btn-sm" target="_blank">View</a>
                    <a href="/admin/posts/<%= p.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                    <form action="/admin/posts/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this post and all its comments?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
