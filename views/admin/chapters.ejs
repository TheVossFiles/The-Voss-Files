<%- include('../partials/header') %>

<div class="admin-layout mt-4 mb-4">
  <%- include('sidebar', { activeTab: 'chapters' }) %>

  <div class="admin-content">
    <% if (editing) { %>
      <!-- Edit Chapter Form -->
      <div class="card mb-4">
        <h3>Edit Chapter: <%= editing.title %></h3>
        <form action="/admin/chapters/<%= editing.id %>" method="POST" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="chapterTitle">Title</label>
            <input type="text" name="title" id="chapterTitle" class="form-control" value="<%= editing.title %>" required>
          </div>

          <div class="form-group">
            <label for="chapterSetting">Setting / Sector</label>
            <input type="text" name="setting" id="chapterSetting" class="form-control" value="<%= editing.setting %>" required>
          </div>

          <div class="form-group">
            <label for="chapterSummary">Summary (Spoiler-light)</label>
            <textarea name="summary" id="chapterSummary" class="form-control" rows="4" required><%= editing.summary %></textarea>
          </div>

          <div class="form-group">
            <label for="chapterMechanic">Mechanic Description</label>
            <input type="text" name="mechanic" id="chapterMechanic" class="form-control" value="<%= editing.mechanic %>" required>
          </div>

          <div class="grid-2">
            <div class="form-group">
              <label for="chapterStatus">Development Status</label>
              <select name="status" id="chapterStatus" class="form-control">
                <option value="Planned" <%= editing.status === 'Planned' ? 'selected' : '' %>>Planned</option>
                <option value="In development" <%= editing.status === 'In development' ? 'selected' : '' %>>In development</option>
                <option value="Playable" <%= editing.status === 'Playable' ? 'selected' : '' %>>Playable</option>
              </select>
            </div>
            <div class="form-group">
              <label for="sortOrder">Sort Order (0-indexed)</label>
              <input type="number" name="sort_order" id="sortOrder" class="form-control" value="<%= editing.sort_order %>" required>
            </div>
          </div>

          <div class="d-flex gap-1 mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/admin/chapters" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    <% } %>

    <!-- Chapter List Table -->
    <div class="card">
      <div class="card-header">
        <h1>All Chapters</h1>
        <span class="badge badge-in-dev"><%= chapters.length %> Chapters</span>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Order</th>
              <th>Title</th>
              <th>Setting</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% chapters.forEach(ch => { %>
              <tr>
                <td><strong>#<%= ch.sort_order %></strong></td>
                <td><strong><%= ch.title %></strong></td>
                <td class="text-secondary text-sm"><%= ch.setting %></td>
                <td>
                  <span class="badge badge-<%= ch.status === 'Playable' ? 'playable' : (ch.status === 'In development' ? 'in-dev' : 'planned') %>"><%= ch.status %></span>
                </td>
                <td>
                  <a href="/admin/chapters/<%= ch.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
