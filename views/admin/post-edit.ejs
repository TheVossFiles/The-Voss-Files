<%- include('../partials/header') %>

<div class="admin-layout mt-4 mb-4">
  <%- include('sidebar', { activeTab: 'posts' }) %>

  <div class="admin-content">
    <div class="card">
      <h1><%= post && post.id ? 'Edit Blog Article' : 'Write New Blog Article' %></h1>

      <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-error mt-2">
          <ul class="error-list">
            <% errors.forEach(err => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="<%= post && post.id ? '/admin/posts/' + post.id : '/admin/posts' %>" method="POST" class="mt-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="postTitle">Article Title</label>
          <input type="text" name="title" id="postTitle" class="form-control" value="<%= post ? post.title : '' %>" required>
        </div>

        <div class="form-group">
          <label for="postSlug">URL Slug (lowercase letters, numbers, hyphens)</label>
          <input type="text" name="slug" id="postSlug" class="form-control" value="<%= post ? post.slug : '' %>" required>
        </div>

        <div class="form-group">
          <label for="postBody">Article Content (Markdown/Text)</label>
          <textarea name="body" id="postBody" class="form-control" rows="12" required><%= post ? post.body : '' %></textarea>
        </div>

        <div class="form-group">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
            <input type="checkbox" name="is_published" value="1" <%= (post && post.is_published) ? 'checked' : '' %>>
            <span>Publish immediately (visible on public Dev Blog)</span>
          </label>
        </div>

        <div class="d-flex gap-1 mt-3">
          <button type="submit" class="btn btn-primary"><%= post && post.id ? 'Save Article' : 'Publish Article' %></button>
          <a href="/admin/posts" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Auto-slug generator for new posts
  const titleInput = document.getElementById('postTitle');
  const slugInput = document.getElementById('postSlug');
  if (titleInput && slugInput && !slugInput.value) {
    titleInput.addEventListener('input', () => {
      slugInput.value = titleInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)+/g, '');
    });
  }
</script>

<%- include('../partials/footer') %>
