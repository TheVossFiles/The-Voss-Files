<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="THE VOSS FILES — First-person 3D psychological mystery escape-room game at Blackwood Institute. Built in Unity 6 for Windows PC and Android.">
  
  <!-- Mobile Browser & Status Bar Theme Color -->
  <meta name="theme-color" content="#0a0e1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="The Voss Files">
  
  <!-- PWA Manifest & Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="manifest" href="/manifest.json">
  
  <!-- Open Graph & Twitter Cards for Rich Social Sharing -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'THE VOSS FILES' %>">
  <meta property="og:description" content="First-person 3D psychological mystery escape-room game at Blackwood Institute. Built in Unity 6 for PC & Android.">
  <meta property="og:image" content="/images/og-preview.svg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'THE VOSS FILES' %>">
  <meta name="twitter:description" content="First-person 3D psychological mystery escape-room game at Blackwood Institute.">
  <meta name="twitter:image" content="/images/og-preview.svg">

  <title><%= typeof title !== 'undefined' ? title : 'THE VOSS FILES' %></title>
  
  <!-- Preconnect & Asynchronous Font Loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css?v=1793604380749">
</head>
<body>
  <!-- Skip to Content Accessibility Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="navbar">
    <div class="navbar-inner">
      <a href="/" class="navbar-brand" aria-label="THE VOSS FILES — Home">
        <span class="brand-title">THE VOSS FILES</span>
        <span class="brand-badge">Blackwood Institute</span>
      </a>

      <button class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="primary-nav">
        <span class="nav-toggle-box">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </span>
      </button>

      <nav class="nav-menu" id="primary-nav">
        <ul class="navbar-links">
          <li><a href="/" class="<%= activePage === 'home' ? 'active' : '' %>">Home</a></li>
          <li><a href="/game" class="<%= activePage === 'game' ? 'active' : '' %>">The Game</a></li>
          <li><a href="/story" class="<%= activePage === 'story' ? 'active' : '' %>">Story & Chapters</a></li>
          <li><a href="/characters" class="<%= activePage === 'characters' ? 'active' : '' %>">Characters</a></li>
          <li><a href="/screenshots" class="<%= activePage === 'screenshots' ? 'active' : '' %>">Screenshots</a></li>
          
          <!-- Explore Dropdown -->
          <li class="nav-dropdown">
            <button type="button" class="nav-dropdown-toggle <%= ['how-its-built', 'leaderboard', 'blog', 'feedback', 'about'].includes(activePage) ? 'active' : '' %>" aria-haspopup="true" aria-expanded="false">
              <span>More</span> <span class="dropdown-caret">▾</span>
            </button>
            <ul class="nav-dropdown-menu">
              <li><a href="/how-its-built" class="<%= activePage === 'how-its-built' ? 'active' : '' %>">⚙️ How It Is Built</a></li>
              <li><a href="/leaderboard" class="<%= activePage === 'leaderboard' ? 'active' : '' %>">⏱️ Leaderboard</a></li>
              <li><a href="/blog" class="<%= activePage === 'blog' ? 'active' : '' %>">✍️ Dev Blog</a></li>
              <li><a href="/feedback" class="<%= activePage === 'feedback' ? 'active' : '' %>">📬 Feedback & Bugs</a></li>
              <li><a href="/about" class="<%= activePage === 'about' ? 'active' : '' %>">🏛️ About Project</a></li>
            </ul>
          </li>
        </ul>

        <div class="nav-actions">
          <a href="/download" class="nav-download-btn <%= activePage === 'download' ? 'active' : '' %>">
            <span class="download-icon">⬇</span> Download
          </a>

          <% if (currentUser) { %>
            <div class="nav-user-group">
              <% if (currentUser.role === 'admin') { %>
                <a href="/admin" class="badge badge-admin <%= activePage === 'admin' ? 'active' : '' %>">Admin</a>
              <% } %>
              <a href="/profile" class="nav-user-link <%= activePage === 'profile' ? 'active' : '' %>"><%= currentUser.username %></a>
              <a href="/logout" class="nav-logout-link" title="Sign out">Logout</a>
            </div>
          <% } else { %>
            <div class="nav-auth-group">
              <a href="/login" class="nav-login-link <%= activePage === 'login' ? 'active' : '' %>">Login</a>
              <a href="/register" class="btn btn-secondary btn-sm nav-reg-btn">Register</a>
            </div>
          <% } %>
        </div>
      </nav>
    </div>
  </header>
  
  <div id="nav-overlay" class="nav-overlay" aria-hidden="true"></div>

  <main id="main-content">
    <div class="container">
      <%- include('flash') %>
